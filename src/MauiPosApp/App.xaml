<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiPosApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#2B6CB0</Color>
            <Color x:Key="PrimaryDark">#1A365D</Color>
            <Color x:Key="Accent">#319795</Color>
            <Color x:Key="Success">#38A169</Color>
            <Color x:Key="Danger">#E53E3E</Color>
            <Color x:Key="Warning">#DD6B20</Color>
            <Color x:Key="BgLight">#F7FAFC</Color>
            <Color x:Key="CardBg">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#2D3748</Color>
            <Color x:Key="TextSecondary">#718096</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
