<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>MauiPosApp</ApplicationTitle>
    <ApplicationId>com.companyname.mauiposapp</ApplicationId>
    <ApplicationVersion>1.0</ApplicationVersion>
    <UseMaui>true</UseMaui>
    <UseMauiTizen>false</UseMauiTizen>
    <NoWarn>$(NoWarn);XC0022;XC0025;XC0045;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.10" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="2.1.10" />
  </ItemGroup>

</Project>
