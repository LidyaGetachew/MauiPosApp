<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiPosApp.ViewModels"
             xmlns:models="clr-namespace:MauiPosApp.Models"
             x:Class="MauiPosApp.Views.OrderHistoryPage"
             Title="Order History">

    <Grid ColumnDefinitions="*,380" Padding="16" ColumnSpacing="16">

        <!-- Left Column: Past Orders List -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="12">
            <StackLayout Grid.Row="0" Orientation="Horizontal" HorizontalOptions="FillAndExpand">
                <Label Text="Completed Order History (SQLite)" FontSize="20" FontAttributes="Bold" TextColor="#1A202C" VerticalOptions="Center" />
                <Button Text="🔄 Refresh" Command="{Binding LoadOrdersCommand}" BackgroundColor="#EDF2F7" TextColor="#2D3748" CornerRadius="6" HorizontalOptions="EndAndExpand" />
            </StackLayout>

            <CollectionView Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder, Mode=TwoWay}" SelectionMode="Single">
                <CollectionView.EmptyView>
                    <Label Text="No past orders recorded in database yet." FontSize="16" TextColor="#A0AEC0" HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <Frame BorderColor="#E2E8F0" CornerRadius="8" Padding="12" Margin="0,0,0,8" BackgroundColor="White">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding OrderNumber}" FontAttributes="Bold" FontSize="16" TextColor="#2B6CB0" />
                                    <Label Text="{Binding CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" FontSize="12" TextColor="#718096" />
                                </StackLayout>

                                <StackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding PaymentMethod}" FontSize="14" FontAttributes="Bold" TextColor="#38A169" />
                                </StackLayout>

                                <Label Grid.Column="2" Text="{Binding GrandTotal, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="#1A202C" VerticalOptions="Center" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Right Column: Selected Order Line Items -->
        <Frame Grid.Column="1" BorderColor="#CBD5E0" CornerRadius="12" Padding="16" BackgroundColor="#F7FAFC" HasShadow="True">
            <StackLayout Spacing="12">
                <Label Text="Order Details" FontSize="20" FontAttributes="Bold" TextColor="#1A202C" />

                <StackLayout IsVisible="{Binding SelectedOrder, Converter={StaticResource Key=StringIsNotNullOrEmptyConverter}}">
                    <Label Text="{Binding SelectedOrder.OrderNumber, StringFormat='Order: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="#2B6CB0" />
                    <Label Text="{Binding SelectedOrder.CreatedAt, StringFormat='Date: {0:yyyy-MM-dd HH:mm:ss}'}" FontSize="12" TextColor="#718096" />
                    <Label Text="{Binding SelectedOrder.PaymentMethod, StringFormat='Payment: {0}'}" FontSize="12" TextColor="#38A169" />
                </StackLayout>

                <CollectionView ItemsSource="{Binding SelectedOrderItems}" HeightRequest="220">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:OrderItem">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="0,4">
                                <Label Grid.Column="0" Text="{Binding ProductName}" FontSize="14" TextColor="#2D3748" />
                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="14" TextColor="#718096" />
                                <Label Grid.Column="2" Text="{Binding TotalPrice, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#2D3748" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="1" Color="#CBD5E0" Margin="0,8" />

                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0" Text="Subtotal:" TextColor="#4A5568" />
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding SelectedOrder.Subtotal, StringFormat='${0:F2}'}" FontAttributes="Bold" TextColor="#2D3748" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Tax (8.5%):" TextColor="#4A5568" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOrder.TaxAmount, StringFormat='${0:F2}'}" FontAttributes="Bold" TextColor="#2D3748" />

                    <Label Grid.Row="2" Grid.Column="0" Text="Grand Total:" FontSize="16" FontAttributes="Bold" TextColor="#1A202C" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedOrder.GrandTotal, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="#2B6CB0" />
                </Grid>
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>
