<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiPosApp.ViewModels"
             xmlns:models="clr-namespace:MauiPosApp.Models"
             x:Class="MauiPosApp.Views.ProductsPage"
             Title="Product Catalog">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Barcode Scan Simulation Bar (Bonus) -->
        <Frame Grid.Row="0" BackgroundColor="#EBF8FF" BorderColor="#3182CE" CornerRadius="8" Padding="8,4">
            <StackLayout Orientation="Horizontal" Spacing="8">
                <Label Text="📷 Scan SKU:" VerticalOptions="Center" FontAttributes="Bold" TextColor="#2B6CB0" />
                <Entry Text="{Binding BarcodeInput}" Placeholder="Enter SKU (e.g. SKU-001)" HorizontalOptions="FillAndExpand" ReturnCommand="{Binding ScanBarcodeCommand}" />
                <Button Text="Scan Product" Command="{Binding ScanBarcodeCommand}" BackgroundColor="#3182CE" TextColor="White" CornerRadius="6" />
            </StackLayout>
        </Frame>

        <!-- Search Bar -->
        <SearchBar Grid.Row="1" Placeholder="Search products by name or SKU..." Text="{Binding SearchQuery}" SearchCommand="{Binding SearchProductsCommand}" />

        <!-- Category Chips -->
        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <StackLayout Orientation="Horizontal" Spacing="8" BindableLayout.ItemsSource="{Binding Categories}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding .}" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, Path=FilterByCategoryCommand}" CommandParameter="{Binding .}" BackgroundColor="#EDF2F7" TextColor="#2D3748" CornerRadius="16" HeightRequest="36" Padding="16,0" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </StackLayout>
        </ScrollView>

        <!-- Product Grid -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Products}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <Frame BorderColor="#E2E8F0" CornerRadius="10" Padding="12" HasShadow="True" BackgroundColor="White">
                        <StackLayout Spacing="6">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#1A202C" />
                            <Label Text="{Binding Sku}" FontSize="12" TextColor="#A0AEC0" />
                            <Label Text="{Binding Category}" FontSize="12" TextColor="#4A5568" />
                            <Label Text="{Binding Price, StringFormat='${0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="#2B6CB0" Margin="0,4,0,0" />
                            <Button Text="+ Add to Cart" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, Path=AddToCartCommand}" CommandParameter="{Binding .}" BackgroundColor="#38A169" TextColor="White" CornerRadius="6" Margin="0,8,0,0" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
